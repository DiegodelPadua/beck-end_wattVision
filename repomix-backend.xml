            );

            return res.status(200).json({
                sucesso: true,
                mensagem: "Local atualizado com sucesso.",
                dados: local
            });

        } catch (erro) {
            return this.tratarErro(erro, res);
        }
    }

    // ======================================
    // PATCH /api/locais/:id/status
