    // Centraliza o tratamento de erros.
    tratarErro(erro, res) {
        console.error("[SETOR]", erro);

        const status =
            Number.isInteger(erro.status) &&
            erro.status >= 400 &&
            erro.status <= 599
                ? erro.status
                : 500;

        return res.status(status).json({
