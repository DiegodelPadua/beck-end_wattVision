import database from "../../config/database.js";

// ==========================================
// REPOSITORY - EQUIPAMENTOS
// ==========================================
// Responsável pelas consultas SQL relacionadas
// aos equipamentos industriais do Watt Vision.

class EquipamentoRepository {

    // Lista os equipamentos e os dados associados.
    async listarTodos() {
        const [equipamentos] = await database.query(`
            SELECT
                e.*,
                s.nome AS setor,
                te.nome AS tipo_equipamento,
                se.nome AS status_equipamento,
                f.nome AS fabricante
            FROM tbl_equipamento e
            INNER JOIN tbl_setor s
                ON e.id_setor = s.id
            INNER JOIN tbl_tipo_equipamento te
                ON e.id_tipo_equipamento = te.id
            INNER JOIN tbl_status_equipamento se
                ON e.id_status_equipamento = se.id
            LEFT JOIN tbl_fabricante f
                ON e.id_fabricante = f.id
            ORDER BY e.id DESC
        `);

        return equipamentos;
    }

    // Consulta um equipamento pelo seu ID.
    async buscarPorId(id) {
        const [equipamentos] = await database.query(
            `
            SELECT *
            FROM tbl_equipamento
            WHERE id = ?
            `,
            [id]
        );

        return equipamentos[0] ?? null;
    }

    // Lista equipamentos pertencentes a um setor.
    async listarPorSetor(idSetor) {
        const [equipamentos] = await database.query(
            `
            SELECT *
            FROM tbl_equipamento
            WHERE id_setor = ?
            ORDER BY nome
            `,
            [idSetor]
        );

        return equipamentos;
    }
}

export default new EquipamentoRepository();
</file>

<file path="src/database/monitoramento/localRepository.js">
import database from "../../config/database.js";

// ==========================================
// REPOSITORY - LOCAIS
// ==========================================
// Responsável pelas consultas SQL da tabela
// tbl_local, utilizando parâmetros seguros.

class LocalRepository {

    // Lista os locais cadastrados.
    async listarTodos() {
        const [locais] = await database.query(`
            SELECT id, nome, descricao, status, id_empresa
            FROM tbl_local
            ORDER BY nome ASC
        `);

        return locais;
    }

    // Busca um local pelo identificador.
    async buscarPorId(id) {
        const [locais] = await database.query(
            `
            SELECT id, nome, descricao, status, id_empresa
            FROM tbl_local
            WHERE id = ?
            `,
            [id]
        );

        return locais[0] ?? null;
    }

    // Verifica se a empresa informada existe.
    async buscarEmpresaPorId(idEmpresa) {
        const [empresas] = await database.query(
            "SELECT id FROM tbl_empresa WHERE id = ?",
            [idEmpresa]
        );

        return empresas[0] ?? null;
    }

    // Insere um novo local.
    async criar(dados) {
        const [resultado] = await database.query(
            `
            INSERT INTO tbl_local
                (nome, descricao, status, id_empresa)
            VALUES (?, ?, ?, ?)
            `,
            [
                dados.nome,
                dados.descricao,
                dados.status,
                dados.id_empresa
            ]
        );

        return resultado.insertId;
    }

    // Atualiza os dados de um local existente.
    async atualizar(id, dados) {
        const [resultado] = await database.query(
            `
            UPDATE tbl_local
            SET nome = ?,
                descricao = ?,
                status = ?,
                id_empresa = ?
            WHERE id = ?
            `,
            [
                dados.nome,
                dados.descricao,
                dados.status,
                dados.id_empresa,
                id
            ]
        );

        return resultado.affectedRows > 0;
    }

    // Atualiza somente o status do local.
    async atualizarStatus(id, status) {
        const [resultado] = await database.query(
            `
            UPDATE tbl_local
            SET status = ?
            WHERE id = ?
            `,
            [status, id]
        );

        return resultado.affectedRows > 0;
    }
}

export default new LocalRepository();
</file>

